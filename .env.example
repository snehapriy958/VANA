# VANA Root Environment Configuration Template
# See backend/.env.example and frontend/.env.example for domain-specific settings.

# Backend Settings
ENVIRONMENT=development
PROJECT_NAME="VANA Environmental Operations Platform"
API_V1_STR=/api/v1
DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:15432/vana_dev
JWT_SECRET_KEY=change-this-in-production-to-a-secure-256-bit-random-secret
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=uploads
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Frontend Settings
VITE_BACKEND_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000/api/v1

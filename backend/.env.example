# VANA — Environment Variables Example
ENVIRONMENT=development
PROJECT_NAME="VANA Environmental Operations Platform"
API_V1_STR=/api/v1

# PostgreSQL Database URLs (asyncpg dialect)
DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:15432/vana_dev
TEST_DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:15432/vana_test

# JWT Authentication Secrets
JWT_SECRET_KEY=change-this-in-production-to-a-secure-256-bit-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Evidence Storage Configuration
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=uploads

# Cross-Origin Resource Sharing (JSON array of origin strings)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

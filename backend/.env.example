# ============================================================================
# VANA Backend Environment Variables Template
# ============================================================================

# 1. Environment Mode
# Set to 'development' for local work, or 'production' for live deployment.
# Note: In production mode, the application will refuse to start if default secrets,
# localhost databases, or wildcard CORS origins are detected.
ENVIRONMENT=development
PROJECT_NAME="VANA Environmental Operations Platform"
API_V1_STR=/api/v1

# 2. Database Connections (PostgreSQL with asyncpg dialect)
# Local development:
DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:15432/vana_dev
TEST_DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:15432/vana_test
# Production (Neon PostgreSQL with SSL):
# DATABASE_URL=postgresql+asyncpg://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?ssl=require
# ALEMBIC_DATABASE_URL=postgresql+asyncpg://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?ssl=require

# 3. JWT Authentication Secrets
# Production requires a secure, random cryptographic secret of at least 32 characters.
JWT_SECRET_KEY=dev-secret-key-must-be-changed-in-production-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# 4. Production Administrator Bootstrap (used once via `python -m app.bootstrap_admin`)
# Set these in your hosting environment before running the bootstrap command.
# Remove BOOTSTRAP_ADMIN_PASSWORD immediately after successful provisioning.
# BOOTSTRAP_ADMIN_EMAIL=admin@vana.earth
# BOOTSTRAP_ADMIN_NAME="System Administrator"
# BOOTSTRAP_ADMIN_PASSWORD="Your#Secure#Bootstrap#Password#2026!"

# 5. Evidence Storage Configuration
# Local development: uploads
# Production on Render with Persistent Disk: /var/data/uploads
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=uploads
# STORAGE_LOCAL_ROOT=/var/data/uploads

# 6. Cross-Origin Resource Sharing (CORS)
# Local development:
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
# Production (exact Vercel / custom domains, no wildcards):
# CORS_ORIGINS=["https://vana.earth","https://vana-frontend.vercel.app"]

# Root .gitignore for VANA Modular Monolith

# Dependencies
node_modules/
.venv/
venv/
env/

# Production build artifacts
dist/
dist-ssr/
build/

# Environment and secrets (strictly exclude all .env files except .env.example)
.env
.env.*
!.env.example

# Python caches and artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor directories and OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Temporary database / storage
storage/
uploads/
temp/
